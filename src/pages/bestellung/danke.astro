---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site.js';
---

<Base titel="Danke für deine Bestellung">
  <section class="abschnitt">
    <div class="rahmen text">
      <h1>Danke für deine Bestellung</h1>
      <p class="versteckt" data-bestellnummer-zeile>Deine Bestellnummer: <strong data-bestellnummer></strong></p>
      <p>
        Deine Bestellung ist bei uns eingegangen. Du bekommst gleich eine Eingangsbestätigung per E-Mail. Schau bitte
        auch im Spam-Ordner nach. Sobald wir die Bestellung annehmen, folgt die Vertragsbestätigung.
      </p>
      <p>
        Bei Versand machen wir dein Paket in den nächsten Werktagen fertig. Bei Abholung ab Hof melden wir uns, um
        einen Termin auszumachen. Du kannst uns auch gleich anrufen:
        <a href={`tel:${SITE.telefonLink}`}>{SITE.telefon}</a>.
      </p>
      <p>
        Fragen zur Bestellung? Schreib uns an <a href={`mailto:${SITE.mail}`}>{SITE.mail}</a>.
      </p>
      <p><a class="knopf" href="/">Zur Startseite</a></p>
    </div>
  </section>
  <script is:inline>
    // Nach einer abgeschlossenen Bestellung den Warenkorb leeren.
    var nummer = new URLSearchParams(window.location.search).get('nr');
    if (nummer && /^DO-[0-9]{6}-[A-Z0-9]{4}$/.test(nummer)) {
      document.querySelector('[data-bestellnummer]').textContent = nummer;
      document.querySelector('[data-bestellnummer-zeile]').classList.remove('versteckt');
    }
    if (new URLSearchParams(window.location.search).get('bestellung')) {
      try {
        window.localStorage.removeItem('oberbrand-warenkorb');
      } catch (e) {}
      document.querySelectorAll('[data-korb-anzahl]').forEach(function (el) {
        el.textContent = '0';
      });
    }
  </script>
</Base>
