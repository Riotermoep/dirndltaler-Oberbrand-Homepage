---
import Base from '../layouts/Base.astro';
import InArbeit from '../components/InArbeit.astro';
import { SITE } from '../data/site.js';
---

<Base titel="Datenschutz">
  <section class="abschnitt">
    <div class="rahmen text">
      <h1>Datenschutz</h1>
      <p>
        Verantwortlich für die Verarbeitung personenbezogener Daten auf dieser Website ist die {SITE.firma},
        {SITE.strasse}, {SITE.ort}, <a href={`mailto:${SITE.mail}`}>{SITE.mail}</a>.
      </p>
      <p>
        Diese Website setzt keine Analyse- oder Werbe-Cookies ein. Der Warenkorb wird ausschließlich in deinem Browser
        gespeichert. Schriften und Bilder werden vom eigenen Server geladen.
      </p>
      <InArbeit />
    </div>
  </section>
</Base>
