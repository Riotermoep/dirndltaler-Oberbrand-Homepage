---
import Base from '../layouts/Base.astro';
import { agb, STAND } from '../data/rechtstexte.js';
---

<Base titel="Allgemeine Geschäftsbedingungen">
  <section class="abschnitt">
    <div class="rahmen text recht">
      <h1>Allgemeine Geschäftsbedingungen</h1>
      {
        agb().map((abschnitt) => (
          <>
            <h2>{abschnitt.titel}</h2>
            {abschnitt.absaetze.map((absatz) => (
              <p>{absatz}</p>
            ))}
          </>
        ))
      }
      <p>
        Zur <a href="/widerrufsbelehrung/">Widerrufsbelehrung</a>
      </p>
      <p class="leise">Stand: {STAND}</p>
    </div>
  </section>
</Base>
