---
import Base from '../layouts/Base.astro';
import { widerrufsbelehrung, MUSTER_FUSS, STAND } from '../data/rechtstexte.js';
---

<Base titel="Widerrufsbelehrung">
  <section class="abschnitt">
    <div class="rahmen text recht">
      <h1>Widerrufsbelehrung</h1>
      {
        widerrufsbelehrung().map((abschnitt) => (
          <>
            <h2>{abschnitt.titel}</h2>
            {abschnitt.absaetze.map((absatz) => (
              <p>{absatz}</p>
            ))}
            {abschnitt.punkte && (
              <>
                <ul>
                  {abschnitt.punkte.map((punkt) => (
                    <li>{punkt}</li>
                  ))}
                </ul>
                <p>{MUSTER_FUSS}</p>
              </>
            )}
            {abschnitt.titel === 'Folgen des Widerrufs' && (
              <p>
                <a class="knopf" href="/widerruf/">
                  Vertrag widerrufen
                </a>
              </p>
            )}
          </>
        ))
      }
      <p class="leise">Stand: {STAND}</p>
    </div>
  </section>
</Base>
